        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "lightning_build_info{node_id=\"$node_id\"}",
          "legendFormat": "{{version}}", "instant": true, "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
